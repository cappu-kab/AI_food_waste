# คัดลอกเป็น .env แล้วแก้ตามเครื่องที่ใช้ (docker compose อ่านให้อัตโนมัติ)

# ขนาดถาดจริง (เส้นผ่านศูนย์กลาง ซม.) — ผิดค่านี้ ตร.ซม./กรัม จะเพี้ยนทั้งระบบ
TRAY_DIAMETER_CM=35

# cpu = ทุกเครื่องรันได้ · 0 = ใช้ GPU ใบแรก (ต้องติดตั้ง NVIDIA Container Toolkit ก่อน)
DEVICE=cpu

# เปลี่ยนพอร์ตถ้า 8899 ชนกับโปรแกรมอื่น
# WEB_PORT=8899
